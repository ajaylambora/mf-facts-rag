# Copy this file to `.env` and fill in your keys. Never commit `.env`.
# Where:  mf-faq-assistant-rag/.env   (same folder as rag_app.py)
# Groq answers first; Mistral is the automatic backup if Groq hits a limit or errors.
GROQ_API_KEY=gsk_paste_your_key_here
MISTRAL_API_KEY=paste_your_mistral_key_here
# Optional: override defaults
# GROQ_MODEL=openai/gpt-oss-20b
# MISTRAL_MODEL=mistral-small-latest
# CHROMA_DIR=./chroma_db
